# BookLoop Environment Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env or .env.local to version control.
# Only publishable/anon keys should be used on the frontend. Never expose service_role keys.

# Supabase API Endpoint
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon / Publishable Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
